{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kondate-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kondate-db",
      // 本番の D1（ローカル開発・テストでは .wrangler/ のローカル DB を使う）
      "database_id": "7fbea7f7-20b5-42a8-a4d1-aff125e613be",
      // ローカルの DB ファイルはこの ID で決まる（本番の ID を入れる前から使っている開発データを引き続き使う）
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // 毎日 03:00（日本時間）に古い日ごとメモを消す
  "triggers": { "crons": ["0 18 * * *"] },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "kondate-images" }],
  // Workers AI はローカルでもリモート実行（利用量がカウントされる）
  "ai": { "binding": "AI", "remote": true },
  // グループごとのリアルタイム同期（WebSocket Hibernation）
  "durable_objects": {
    "bindings": [{ "name": "GROUP_ROOM", "class_name": "GroupRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GroupRoom"] }],
  "vars": {
    "AI_DAILY_LIMIT": "20",
    // 本番の URL（Google のリダイレクト先に使う）。ローカルでは .dev.vars の値で上書きされる
    "APP_URL": "https://kondate-app.naikou7110.workers.dev",
  },
}
