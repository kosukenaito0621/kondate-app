{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/react"]
  },
  // hc<AppType> の型解決のため Worker の型定義も読む（Workerコード自体はバンドルされない）
  "include": ["src/app", "src/shared", "src/worker/worker-configuration.d.ts"],
  "exclude": ["**/*.test.ts"]
}
